{
  "name": "monorepo-fullstack-starterkit",
  "packageManager": "pnpm@9.14.0",
  "private": true,
  "scripts": {
    "api": "pnpm --filter '@apps/api'",
    "web": "pnpm --filter '@apps/web'",
    "ui": "pnpm --filter '@packages/ui'",
    "auth": "pnpm --filter '@packages/auth'",
    "db": "pnpm --filter '@packages/database'",
    "check-types": "tsc --noEmit",
    "nuke": "rimraf **/node_modules",
    "cruise": "pnpm depcruise",
    "format": "biome check --write --unsafe --no-errors-on-unmatched --verbose --files-ignore-unknown 'true'",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "prepare": "husky"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "dependency-cruiser": "^16.10.4",
    "lint-staged": "^15.4.3",
    "rimraf": "^6.0.1",
    "syncpack": "13",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "husky": "^9.1.7"
  }
}
